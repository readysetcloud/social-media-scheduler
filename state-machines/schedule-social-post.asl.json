{
  "QueryLanguage": "JSONata",
  "Comment": "Process incoming messages in batch for scheduling",
  "StartAt": "Load account",
  "States": {
    "Load account": {
      "Type": "Task",
      "Resource": "${DynamoDbGetItem}",
      "Arguments": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S": "{% $states.context.Execution.Input.detail.tenantId %}"
          },
          "sk": {
            "S": "{% \"account#\" & $states.context.Execution.Input.detail.accountId %}"
          }
        }
      },
      "Next": "Does account exist?",
      "Output": {
        "detail": "{% $states.context.Execution.Input.detail %}",
        "account": "{% $states.result %}"
      }
    },
    "Does account exist?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Configure reference number",
          "Condition": "{% $exists($states.input.account.Item) %}",
          "Assign": {
            "account": "{% $states.input.account.Item %}"
          }
        }
      ],
      "Default": "Stop execution"
    },
    "Configure reference number": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.detail.referenceNumber) %}",
          "Next": "Save messages",
          "Assign": {
            "referenceNumber": "{% $states.input.detail.referenceNumber %}",
            "accountId": "{% $states.context.Execution.Input.detail.accountId %}",
            "tenantId": "{% $states.context.Execution.Input.detail.tenantId %}"
          }
        },
        {
          "Condition": "{% $not($exists($states.input.detail.referenceNumber)) %}",
          "Next": "Save messages",
          "Assign": {
            "referenceNumber": "{% $uuid() %}",
            "accountId": "{% $states.context.Execution.Input.detail.accountId %}",
            "tenantId": "{% $states.context.Execution.Input.detail.tenantId %}"
          }
        }
      ],
      "Default": "Stop execution"
    },
    "Save messages": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Arguments": {
        "FunctionName": "${SaveMessages}",
        "Payload": {
          "tenantId": "{% $tenantId %}",
          "accountId": "{% $accountId %}",
          "referenceNumber": "{% $referenceNumber %}",
          "messages": "{% $states.context.Execution.Input.detail.messages %}"
        }
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Determine message scheduled dates"
    },
    "Determine message scheduled dates": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Has scheduled date?",
        "States": {
          "Has scheduled date?": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $exists($states.input.messageDetail.scheduledDate) %}",
                "Next": "Update message status - pending",
                "Assign": {
                  "scheduledDate": "{% $states.input.messageDetail.scheduledDate %}"
                }
              }
            ],
            "Default": "Load post schedule"
          },
          "Load post schedule": {
            "Type": "Task",
            "Next": "Has schedule items?",
            "Arguments": {
              "TableName": "${TableName}",
              "IndexName": "schedules",
              "KeyConditionExpression": "#type = :type",
              "ExpressionAttributeNames": {
                "#type": "type"
              },
              "ExpressionAttributeValues": {
                ":type": {
                  "S": "{% $tenantId & \"#\" & $accountId & \"#\" & $states.input.messageDetail.platform %}"
                }
              }
            },
            "Resource": "${DynamoDbQuery}",
            "Assign": {
              "schedule": "{% $states.result.Items %}"
            },
            "Output": "{% $states.input %}"
          },
          "Has schedule items?": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $count($schedule) > 0 %}",
                "Next": "Unmarshall schedule"
              },
              {
                "Condition": "{% $count($schedule) = 0 %}",
                "Next": "Get schedule date",
                "Assign": {
                  "schedule": []
                }
              }
            ],
            "Default": "Get schedule date"
          },
          "Unmarshall schedule": {
            "Type": "Task",
            "Resource": "${LambdaInvoke}",
            "Arguments": {
              "FunctionName": "${UnmarshallDataFunction}",
              "Payload": {
                "marshall": false,
                "isDynamoDBQuery": true,
                "data": "{% $schedule %}"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "Get schedule date",
            "Assign": {
              "schedule": "{% $states.result.Payload.data[sort !=\"DO_NOT_SEND\"] ? $states.result.Payload.data[sort !=\"DO_NOT_SEND\"] : [] %}"
            },
            "Output": {
              "messageDetail": "{% $states.input.messageDetail %}"
            }

          },
          "Get schedule date": {
            "Type": "Task",
            "Resource": "${LambdaInvoke}",
            "Arguments": {
              "FunctionName": "${CalculateScheduleFunction}",
              "Payload": {
                "tenantId": "{% $tenantId %}",
                "accountId": "{% $accountId %}",
                "post": "{% $states.input.messageDetail %}",
                "schedule": "{% $schedule %}",
                "timestamp": "{% $now() %}"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 5,
                "MaxAttempts": 5,
                "BackoffRate": 5
              }
            ],
            "Next": "Update message status - pending",
            "Output": {
              "messageDetail": "{% $states.input.messageDetail %}"
            },
            "Assign": {
              "scheduledDate": "{% $states.result.Payload.date %}"
            }
          },
          "Update message status - pending": {
            "Type": "Task",
            "Resource": "${DynamoDbUpdateItem}",
            "Arguments": {
              "TableName": "${TableName}",
              "Key": {
                "pk": {
                  "S": "{% $tenantId & \"#\" & $accountId & \"#\" & $states.input.messageDetail.id %}"
                },
                "sk": {
                  "S": "message"
                }
              },
              "UpdateExpression": "SET #status = :status, #scheduledDate = :scheduledDate, #lastUpdate = :lastUpdate",
              "ExpressionAttributeNames": {
                "#status": "status",
                "#scheduledDate": "scheduledDate",
                "#lastUpdate": "lastUpdate"
              },
              "ExpressionAttributeValues": {
                ":status": {
                  "S": "pending"
                },
                ":scheduledDate": {
                  "S": "{% $scheduledDate %}"
                },
                ":lastUpdate": {
                  "S": "{% $now() %}"
                }
              }
            },
            "End": true,
            "Output": "{% $merge([$states.input.messageDetail, { \"scheduledDate\": $scheduledDate }]) %}"
          }
        }
      },
      "Next": "Requires verification?",
      "Items": "{% $states.input.messages %}",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "messageDetail": "{% $states.context.Map.Item.Value %}"
      }
    },
    "Requires verification?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Send verification email",
          "Condition": "{% $states.context.Execution.Input.detail.verifyMessages = true %}"
        }
      ],
      "Default": "Schedule messages"
    },
    "Send verification email": {
      "Type": "Task",
      "Resource": "${EventBridgePutEventsAndWait}",
      "HeartbeatSeconds": 86400,
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "referenceNumber": "{% $referenceNumber %}",
              "taskToken": "{% $states.context.Task.Token %}",
              "contact": "{% $account.contact.S %}"
            },
            "DetailType": "Send Review Email",
            "Source": "scheduler"
          }
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.HeartbeatTimeout"
          ],
          "Next": "Stop execution"
        }
      ],
      "Next": "Schedule messages"
    },
    "Schedule messages": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Is message already scheduled?",
        "States": {
          "Is message already scheduled?": {
            "Type": "Task",
            "Next": "Update message posting details",
            "Arguments": {
              "Name": "{% $tenantId & \"-\" & $accountId & \"-\" & $states.input.messageDetail.platform & \"-\" & $states.input.messageDetail.id %}",
              "GroupName": "social"
            },
            "Resource": "${SchedulerGetSchedule}",
            "Catch": [
              {
                "ErrorEquals": [
                  "Scheduler.ResourceNotFoundException"
                ],
                "Next": "Schedule message for posting",
                "Output": {
                  "messageDetail": "{% $states.input.messageDetail %}"
                }
              }
            ],
            "Output": {
              "messageDetail": "{% $states.input.messageDetail %}"
            }
          },
          "Update message posting details": {
            "Type": "Task",
            "Next": "Update message status - scheduled",
            "Arguments": {
              "ActionAfterCompletion": "DELETE",
              "FlexibleTimeWindow": {
                "Mode": "FLEXIBLE",
                "MaximumWindowInMinutes": 3
              },
              "Name": "{% $tenantId & \"-\" & $accountId & \"-\" & $states.input.messageDetail.platform & \"-\" & $states.input.messageDetail.id %}",
              "GroupName": "social",
              "ScheduleExpression": "{% \"at(\" & $states.input.messageDetail.scheduledDate & \")\" %}",
              "Target": {
                "Arn": "${SendSocialPostStateMachine}",
                "RoleArn": "${SchedulerRole}",
                "DeadLetterConfig": {
                  "Arn": "${DeadLetterQueue}"
                },
                "Input": {
                  "messageId": "{% $states.input.messageDetail.id %}",
                  "accountId": "{% $accountId %}",
                  "tenantId": "{% $tenantId %}"
                }
              }
            },
            "Resource": "${SchedulerUpdateSchedule}",
            "Output": {
              "messageDetail": "{% $states.input.messageDetail %}"
            }
          },
          "Schedule message for posting": {
            "Type": "Task",
            "Next": "Update message status - scheduled",
            "Arguments": {
              "ActionAfterCompletion": "DELETE",
              "FlexibleTimeWindow": {
                "Mode": "FLEXIBLE",
                "MaximumWindowInMinutes": 3
              },
              "Name": "{% $tenantId & \"-\" & $accountId & \"-\" & $states.input.messageDetail.platform & \"-\" & $states.input.messageDetail.id %}",
              "GroupName": "social",
              "ScheduleExpression": "{% \"at(\" & $states.input.messageDetail.scheduledDate & \")\" %}",
              "Target": {
                "Arn": "${SendSocialPostStateMachine}",
                "RoleArn": "${SchedulerRole}",
                "DeadLetterConfig": {
                  "Arn": "${DeadLetterQueue}"
                },
                "Input": {
                  "messageId": "{% $states.input.messageDetail.id %}",
                  "accountId": "{% $accountId %}",
                  "tenantId": "{% $tenantId %}"
                }
              }
            },
            "Resource": "${SchedulerCreateSchedule}",
            "Output": {
              "messageDetail": "{% $states.input.messageDetail %}"
            }
          },
          "Update message status - scheduled": {
            "Type": "Task",
            "Resource": "${DynamoDbUpdateItem}",
            "Arguments": {
              "TableName": "${TableName}",
              "Key": {
                "pk": {
                  "S": "{% $tenantId & \"#\" & $accountId & \"#\" & $states.input.messageDetail.id %}"
                },
                "sk": {
                  "S": "message"
                }
              },
              "UpdateExpression": "SET #status = :status, #scheduledDate = :scheduledDate, #lastUpdate = :lastUpdate REMOVE #ttl",
              "ExpressionAttributeNames": {
                "#status": "status",
                "#scheduledDate": "sort",
                "#lastUpdate": "lastUpdate",
                "#ttl": "ttl"
              },
              "ExpressionAttributeValues": {
                ":status": {
                  "S": "scheduled"
                },
                ":scheduledDate": {
                  "S": "{% $states.input.messageDetail.scheduledDate %}"
                },
                ":lastUpdate": {
                  "S": "{% $now() %}"
                }
              }
            },
            "End": true,
            "Output": "{% $states.input.messageDetail %}"
          }
        }
      },
      "Next": "Publish messages scheduled event",
      "ItemSelector": {
        "messageDetail": "{% $states.context.Map.Item.Value %}"
      }
    },
    "Publish messages scheduled event": {
      "Type": "Task",
      "Resource": "${EventBridgePutEvents}",
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "referenceNumber": "{% $referenceNumber %}",
              "accountId": "{% $accountId %}",
              "tenantId": "{% $tenantId %}"
            },
            "DetailType": "Messages Scheduled",
            "Source": "SocialPostScheduler"
          }
        ]
      },
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    },
    "Stop execution": {
      "Type": "Fail"
    }
  }
}
