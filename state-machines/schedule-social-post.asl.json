{
  "QueryLanguage": "JSONata",
  "Comment": "Process incoming messages in batch for scheduling",
  "StartAt": "Load account",
  "States": {
    "Load account": {
      "Type": "Task",
      "Resource": "${DynamoDbGetItem}",
      "Arguments": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S": "{% $states.context.Execution.Input.detail.accountId %}"
          },
          "sk": {
            "S": "account"
          }
        }
      },
      "Next": "Does account exist?",
      "Output": "{% {\"detail\": $states.context.Execution.Input.detail, \"account\": $states.result }%}"
    },
    "Does account exist?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Configure reference number",
          "Condition": "{% $exists($states.input.account.Item) %}",
          "Assign": {
            "account": "{% $states.input.account.Item %}"
          }
        }
      ],
      "Default": "Stop execution"
    },
    "Configure reference number": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($states.input.detail.referenceNumber) %}",
          "Next": "Save messages",
          "Assign": {
            "referenceNumber": "{% $states.input.detail.referenceNumber %}",
            "accountId": "{% $states.context.Execution.Input.detail.accountId %}"
          }
        },
        {
          "Condition": "{% $not($exists($states.input.detail.referenceNumber)) %}",
          "Next": "Save messages",
          "Assign": {
            "referenceNumber": "{% $uuid() %}",
            "accountId": "{% $states.context.Execution.Input.detail.accountId %}"
          }
        }
      ],
      "Default": "Stop execution"
    },
    "Save messages": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Arguments": {
        "FunctionName": "${SaveMessages}",
        "Payload": {
          "accountId": "{% $accountId %}",
          "referenceNumber": "{% $referenceNumber %}",
          "messages": "{% $states.context.Execution.Input.detail.messages %}"
        }
      },
      "Output": "{% $states.result.Payload %}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Requires verification?"
    },
    "Requires verification?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Send verification email",
          "Condition": "{% $states.context.Execution.Input.detail.verifyMessages = true %}"
        }
      ],
      "Default": "Iterate messages"
    },
    "Send verification email": {
      "Type": "Task",
      "Resource": "${EventBridgePutEventsAndWait}",
      "HeartbeatSeconds": 86400,
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "referenceNumber": "{% $referenceNumber %}",
              "taskToken": "{% $states.context.Task.Token %}",
              "contact": "{% $account.contact.S %}"
            },
            "DetailType": "Send Review Email",
            "Source": "scheduler"
          }
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.HeartbeatTimeout"
          ],
          "Next": "Stop execution"
        }
      ],
      "Next": "Iterate messages"
    },
    "Iterate messages": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Has scheduled date?",
        "States": {
          "Has scheduled date?": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $exists($states.input.messageDetail.scheduledDate) %}",
                "Next": "Does EB schedule already exist?",
                "Assign": {
                  "scheduledDate": "{% $states.input.messageDetail.scheduledDate %}"
                }
              }
            ],
            "Default": "Load post schedule"
          },
          "Load post schedule": {
            "Type": "Task",
            "Next": "Has schedule items?",
            "Arguments": {
              "TableName": "${TableName}",
              "IndexName": "schedules",
              "KeyConditionExpression": "#type = :type",
              "ExpressionAttributeNames": {
                "#type": "type"
              },
              "ExpressionAttributeValues": {
                ":type": {
                  "S": "{% $accountId & \"#\" & $states.input.messageDetail.platform %}"
                }
              }
            },
            "Resource": "${DynamoDbQuery}",
            "Assign": {
              "schedule": "{% $states.result.Items %}"
            },
            "Output": "{% $states.input %}"
          },
          "Has schedule items?": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $count($schedule) > 0 %}",
                "Next": "Unmarshall schedule"
              },
              {
                "Condition": "{% $count($schedule) = 0 %}",
                "Next": "Get schedule date",
                "Assign": {
                  "schedule": []
                }
              }
            ],
            "Default": "Get schedule date"
          },
          "Unmarshall schedule": {
            "Type": "Task",
            "Resource": "${LambdaInvoke}",
            "Arguments": {
              "FunctionName": "${UnmarshallDataFunction}",
              "Payload": "{% {\"marshall\": false, \"isDynamoDBQuery\": true, \"data\": $schedule } %}"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "Get schedule date",
            "Assign": {
              "schedule": "{% $states.result.Payload.data %}"
            }
          },
          "Get schedule date": {
            "Type": "Task",
            "Resource": "${LambdaInvoke}",
            "Arguments": {
              "FunctionName": "${CalculateScheduleFunction}",
              "Payload": "{% { \"accountId\": $accountId, \"post\": $states.input.messageDetail, \"schedule\": $schedule, \"timestamp\": $states.context.Execution.Input.startTime } %}"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "Does EB schedule already exist?",
            "Assign": {
              "scheduledDate": "{% $states.result.Payload.date %}"
            }
          },
          "Does EB schedule already exist?": {
            "Type": "Task",
            "Next": "Update EB schedule",
            "Arguments": {
              "Name": "{% $accountId & \"-\" & $states.input.messageDetail.platform & \"-\" & $referenceNumber %}",
              "GroupName": "social"
            },
            "Resource": "${SchedulerGetSchedule}",
            "Catch": [
              {
                "ErrorEquals": [
                  "Scheduler.ResourceNotFoundException"
                ],
                "Next": "Create one-time EB schedule"
              }
            ]
          },
          "Update EB schedule": {
            "Type": "Task",
            "Next": "Has campaign?",
            "Arguments": {
              "ActionAfterCompletion": "DELETE",
              "FlexibleTimeWindow": {
                "Mode": "FLEXIBLE",
                "MaximumWindowInMinutes": 8
              },
              "Name": "{% $accountId & \"-\" & $states.input.messageDetail.platform & \"-\" & $referenceNumber %}",
              "GroupName": "social",
              "ScheduleExpression": "{% \"at(\" & $scheduledDate & \")\" %}",
              "Target": {
                "Arn": "${SendSocialPostStateMachine}",
                "RoleArn": "${SchedulerRole}",
                "DeadLetterConfig": {
                  "Arn": "${DeadLetterQueue}"
                },
                "Input": {
                  "referenceNumber": "$referenceNumber",
                  "detail": "$states.input.messageDetail"
                }
              }
            },
            "Resource": "${SchedulerUpdateSchedule}"
          },
          "Has campaign?": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $exists($states.input.messageDetail.campaign) %}",
                "Next": "Save EB schedule with campaign"
              }
            ],
            "Default": "Save EB schedule without campaign"
          },
          "Save EB schedule with campaign": {
            "Type": "Task",
            "Resource": "${DynamoDbPutItem}",
            "Arguments": {
              "TableName": "${TableName}",
              "Item": {
                "pk": {
                  "S": "{% $referenceNumber %}"
                },
                "sk": {
                  "S": "post"
                },
                "accountId": { "S": "{% $accountId %}" },
                "platform": { "S": "{% $states.input.messageDetail.platform %}" },
                "type": {
                  "S": "{% $accountId & \"#\" & $states.input.messageDetail.platform %}"
                },
                "sort": {
                  "S": "{% $scheduledDate %}"
                },
                "message": {
                  "S": "{% $states.input.messageDetail.message %}"
                },
                "campaign": {
                  "S": "{% $accountId & \"#\" & $states.input.messageDetail.campaign %}"
                }
              }
            },
            "End": true
          },
          "Save EB schedule without campaign": {
            "Type": "Task",
            "Resource": "${DynamoDbPutItem}",
            "Arguments": {
              "TableName": "${TableName}",
              "Item": {
                "pk": {
                  "S": "{% $referenceNumber %}"
                },
                "sk": {
                  "S": "post"
                },
                "accountId": { "S": "{% $accountId %}" },
                "platform": { "S": "{% $states.input.messageDetail.platform %}" },
                "type": {
                  "S": "{% $accountId & \"#\" & $states.input.messageDetail.platform %}"
                },
                "sort": {
                  "S": "{% $scheduledDate %}"
                },
                "message": {
                  "S": "{% $states.input.messageDetail.message %}"
                }
              }
            },
            "End": true
          },
          "Create one-time EB schedule": {
            "Type": "Task",
            "Next": "Send schedule created event",
            "Arguments": {
              "ActionAfterCompletion": "DELETE",
              "FlexibleTimeWindow": {
                "Mode": "FLEXIBLE",
                "MaximumWindowInMinutes": 8
              },
              "Name": "{% $accountId & \"-\" & $states.input.messageDetail.platform & \"-\" & $referenceNumber %}",
              "GroupName": "social",
              "ScheduleExpression": "{% \"at(\" & $scheduledDate & \")\" %}",
              "Target": {
                "Arn": "${SendSocialPostStateMachine}",
                "RoleArn": "${SchedulerRole}",
                "DeadLetterConfig": {
                  "Arn": "${DeadLetterQueue}"
                },
                "Input": {
                  "referenceNumber": "{% $referenceNumber %}",
                  "detail": "{% $states.input.messageDetail %}"
                }
              }
            },
            "Resource": "${SchedulerCreateSchedule}"
          },
          "Send schedule created event": {
            "Type": "Task",
            "Resource": "${EventBridgePutEvents}",
            "Arguments": {
              "Entries": [
                {
                  "Detail": {
                    "referenceNumber": "{% $referenceNumber %}",
                    "scheduledDate": "{% $scheduledDate %}",
                    "accountId": "{% $accountId %}"
                  },
                  "DetailType": "Post Scheduled",
                  "Source": "SocialPostScheduler"
                }
              ]
            },
            "Next": "Has campaign?"
          }
        }
      },
      "Next": "Success",
      "Items": "{% $states.input.detail.messages %}",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "messageDetail": "{% $states.context.Map.Item.Value %}"
      }
    },
    "Success": {
      "Type": "Succeed"
    },
    "Stop execution": {
      "Type": "Fail"
    }
  }
}
