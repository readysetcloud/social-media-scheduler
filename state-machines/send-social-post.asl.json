{
  "QueryLanguage": "JSONata",
  "Comment": "Sends a social post",
  "StartAt": "Load message",
  "States": {
    "Load message": {
      "Type": "Task",
      "Resource": "${DynamoDbGetItem}",
      "Arguments": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S": "{% $states.input.accountId & \"#\" & $states.input.messageId %}"
          },
          "sk": {
            "S": "message"
          }
        }
      },
      "Next": "Does message exist?",
      "Output": {
        "message": "{% $states.result %}"
      }
    },
    "Does message exist?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Unmarshall message",
          "Condition": "{% $exists($states.input.message.Item) %}",
          "Assign": {
            "message": "{% $states.input.message.Item %}",
            "accountId": "{% $states.context.Execution.Input.accountId %}",
            "messageId": "{% $states.context.Execution.Input.messageId %}"
          }
        }
      ],
      "Default": "Successfully sent?"
    },
    "Unmarshall message": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Arguments": {
        "FunctionName": "${UnmarshallDataFunction}",
        "Payload": {
          "marshall": false,
          "isDynamoDBQuery": false,
          "data": "{% $message %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Which platform?",
      "Assign": {
        "message": "{% $states.result.Payload.data %}"
      }
    },
    "Which platform?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $message.platform = \"x\" %}",
          "Next": "Send X post"
        },
        {
          "Condition": "{% $message.platform = \"discord\" %}",
          "Next": "Send Discord message"
        }
      ],
      "Default": "Update message status",
      "Assign": {
        "status": "cancelled"
      }
    },
    "Send X post": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "${SendXPost}",
        "Payload": "{% $merge([$message, {\"accountId\": $accountId }]) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Update message status",
          "Assign": {
            "status": "failed"
          }
        }
      ],
      "Next": "Update message status",
      "Assign": {
        "postId": "{% $states.result.Payload.id %}",
        "status": "sent"
      }
    },
    "Send Discord message": {
      "Type": "Task",
      "Resource": "${LambdaInvoke}",
      "Arguments": {
        "FunctionName": "${SendDiscordMessage}",
        "Payload": "{% $merge([$message, {\"accountId\": $accountId }]) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Output": "{% $states.result.Payload %}",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Update message status",
          "Assign": {
            "status": "failed"
          }
        }
      ],
      "Next": "Update message status",
      "Assign": {
        "postId": "{% $states.result.Payload.id %}",
        "status": "sent"
      }
    },
    "Update message status": {
      "Type": "Task",
      "Resource": "${DynamoDbUpdateItem}",
      "Arguments": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S": "{% $accountId & \"#\" & $messageId %}"
          },
          "sk": {
            "S": "message"
          }
        },
        "UpdateExpression": "SET #status = :status, #lastUpdate = :lastUpdate",
        "ExpressionAttributeNames": {
          "#status": "status",
          "#lastUpdate": "lastUpdate"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "{% $status %}"
          },
          ":lastUpdate": {
            "S": "{% $now() %}"
          }
        }
      },
      "Next": "Successfully sent?"
    },
    "Successfully sent?": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $status = \"sent\" %}",
          "Next": "Send social post sent event"
        }
      ],
      "Default": "Send social post failed event"
    },
    "Send social post failed event": {
      "Type": "Task",
      "Resource": "${EventBridgePutEvents}",
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "messageId": "{% $messageId %}",
              "accountId": "{% $accountId %}"
            },
            "DetailType": "Social Post Failed",
            "Source": "SocialPostSender"
          }
        ]
      },
      "Next": "Something went wrong"
    },
    "Something went wrong": {
      "Type": "Fail",
      "Error": "PostFailed",
      "Cause": "Something went wrong sending the post"
    },
    "Send social post sent event": {
      "Type": "Task",
      "Resource": "${EventBridgePutEvents}",
      "Arguments": {
        "Entries": [
          {
            "Detail": {
              "messageId": "{% $messageId %}",
              "postId": "{% $states.input.id %}",
              "accountId": "{% $accountId %}"
            },
            "DetailType": "Social Post Sent",
            "Source": "SocialPostSender"
          }
        ]
      },
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
