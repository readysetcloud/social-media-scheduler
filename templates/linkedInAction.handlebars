{{#if (eq linkedIn.status 'active')}}
  <button type="button" class="bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700" onClick="revokeLinkedIn()">
    Revoke
  </button>
{{else if (eq linkedIn.status 'expired')}}
  <button type="button" class="bg-yellow-500 text-white py-2 px-4 rounded-md hover:bg-yellow-600" onClick="authenticateLinkedIn()">
    Re-authenticate
  </button>
{{else}}
  <button type="button" class="bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700" onClick="authenticateLinkedIn()">
    Authenticate
  </button>
{{/if}}
